# =============================================================================
#  SciPulse — Variables d'environnement (modèle)
#  Pour créer .env : `make env` (ou python scripts/init_env.py).
#  Les identifiants reprennent ceux du squelette du cours (environnement
#  local de TP). Les clés internes Airflow sont générées aléatoirement.
#  En production : mots de passe forts, gestionnaire de secrets.
#  Le fichier .env est ignoré par Git.
# =============================================================================

COMPOSE_PROJECT_NAME=scipulse

# --- Elastic Stack ---
STACK_VERSION=8.13.4
ES_JAVA_HEAP=1g

# --- PostgreSQL (métastore Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- MinIO (data lake S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=__FERNET__
AIRFLOW_SECRET_KEY=__GENERATE__

# --- Spark ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# --- OpenAlex (polite pool : un e-mail de contact augmente les quotas) ---
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# --- Échantillon ArXiv (jeu de test : réduire la taille / changer la graine) ---
ARXIV_SAMPLE_SIZE=100000
ARXIV_MIN_YEAR=2015
ARXIV_SEED=42

# --- Alertes (optionnel : webhook Slack / Teams / Discord) ---
ALERT_WEBHOOK_URL=
