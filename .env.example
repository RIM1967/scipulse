# =============================================================================
#  SciPulse — Variables d'environnement (modèle)
#  NE PAS éditer à la main pour créer .env : lancer `make env`
#  (scripts/init_env.py remplace __GENERATE__ / __FERNET__ par des secrets
#  aléatoires). Le fichier .env est ignoré par Git.
# =============================================================================

COMPOSE_PROJECT_NAME=scipulse

# --- Elastic Stack ---
STACK_VERSION=8.13.4
ES_JAVA_HEAP=1g

# --- PostgreSQL (métastore Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=airflow

# --- MinIO (data lake S3) ---
MINIO_ROOT_USER=scipulse
MINIO_ROOT_PASSWORD=__GENERATE__

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__GENERATE__
AIRFLOW_FERNET_KEY=__FERNET__
AIRFLOW_SECRET_KEY=__GENERATE__

# --- Spark ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# --- OpenAlex (polite pool : un e-mail de contact augmente les quotas) ---
OPENALEX_MAILTO=
